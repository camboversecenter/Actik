# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The trust Root's PUBLIC key(s), pinned into this build. Verifiers trust an
# institution only if a list signed by one of these keys says so — never the
# database. Generate with:
#   npx tsx scripts/trust-root-keygen.ts --out /somewhere/outside/this/repo/root.private.jwk.json
# and paste the line it prints. A JSON array; list two during a Root rotation.
# Leave it empty and the app verifies nothing, and says so.
VITE_TRUST_ROOT_KEYS=
